# Local development only; copy to .env (git-ignored). Deployed config comes from the root bundle.
DATABRICKS_HOST=https://...
DATABRICKS_CONFIG_PROFILE=your_cli_profile
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_CATALOG=classic_stable
DATABRICKS_SCHEMA=auto_intelligence
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=auto-intelligence

# Market Genie Agent (scripts/genie/deploy_space.sh prints the id)
DATABRICKS_GENIE_SPACE_ID=
